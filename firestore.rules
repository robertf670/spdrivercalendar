rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Live Updates Collection
    // All users can read (for banners and live updates screen)
    // Anyone can write (admin access controlled at app level)
    match /live_updates/{document} {
      allow read: if true;
      allow write: if true;
      
      // Votes subcollection for polls
      // Users can create votes (one per user per poll enforced by transaction)
      // Users can read votes (for checking if they voted)
      // Delete allowed for admin vote resets (admin access controlled at app level)
      match /votes/{voteId} {
        allow read: if true;
        allow create: if true;
        allow update: if false; // Votes are immutable once created
        allow delete: if true; // Allow deletion for admin vote resets
      }
    }
    
    // User Activity Collections  
    // For anonymous analytics tracking
    match /daily_activity/{document} {
      allow read: if true;  // For admin analytics dashboard
      allow write: if true; // For anonymous user activity tracking
    }
    
    match /user_activity/{document} {
      allow read: if true;  // For admin analytics dashboard
      allow write: if true; // For anonymous user activity tracking
    }
    
    // Toilet Codes - all users can read, admin can write (app-level control)
    match /toilet_codes/{document} {
      allow read: if true;
      allow write: if true;
    }

    // Contacts - all users can read, admin can write (app-level control)
    match /contacts/{document} {
      allow read: if true;
      allow write: if true;
    }

    match /contact_sections/{document} {
      allow read: if true;
      allow write: if true;
    }

    // Duty ratings — public read; create/update votes; delete for admin
    // spam-score removal. Summaries are written by the same app transaction.
    // Same honesty as polls/contacts: app-level control, not Firebase Auth.
    match /duty_rating_votes/{document} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /duty_rating_summaries/{document} {
      allow read: if true;
      allow write: if true;
    }

    // Bus defect reports — public read; create/update/delete for own
    // remove and admin spam removal. Summaries written in the same
    // app transaction. App-level control, not Firebase Auth.
    match /bus_defect_reports/{document} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /bus_defect_summaries/{document} {
      allow read: if true;
      allow write: if true;
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}